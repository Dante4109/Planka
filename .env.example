# Planka Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# PostgreSQL connection (host.docker.internal = this Windows machine)
DATABASE_URL=postgresql://planka:YOUR_DB_PASSWORD@host.docker.internal:5432/planka

# Must be a random 64+ byte hex string. Generate with:
#   PowerShell: [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64)).Replace("-","").ToLower()
SECRET_KEY_BASE=YOUR_SECRET_KEY_BASE_HERE

# Base URL — use LAN IP for local-only, change to domain when remote access is set up
BASE_URL=http://192.168.1.174:1337

# Optional: Comma-separated list of allowed IPs/ranges for admin access
# TRUST_PROXY=

# ── Planka Tools API credentials ─────────────────────────────────────────────
# Used by 'pt' CLI and automation scripts to talk to the Planka REST API.
# Prefer API key (no expiry, no ToS flow). Create one in Planka → Profile → API keys.
PLANKA_API_KEY=YOUR_API_KEY_HERE

# Alternatively, username/password auth (Bearer JWT):
# PLANKA_USERNAME=r3zadmin
# PLANKA_PASSWORD=YOUR_PASSWORD_HERE

# ── Automation scheduler ──────────────────────────────────────────────────────
# Comma-separated board IDs to watch (get IDs via: pt api list-boards <project-id>)
PLANKA_AUTOMATION_BOARDS=YOUR_BOARD_ID_HERE

# Custom field name to sum for list point totals (default: Points)
PLANKA_POINTS_FIELD=Points

# How often to poll for changes, in seconds (default: 60)
PLANKA_POLL_INTERVAL=60

# ── Webhook receiver ──────────────────────────────────────────────────────────
# Secret token Planka sends in the Authorization header. Generate with:
#   PowerShell: [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace("-","").ToLower()
PLANKA_WEBHOOK_TOKEN=YOUR_WEBHOOK_TOKEN_HERE

# Port the webhook Flask server listens on inside its container (default: 5001)
PLANKA_WEBHOOK_PORT=5001

# Planka API URL used by the webhook container (Docker DNS — do not change)
# This is set automatically via docker-compose.yml environment override.
# PLANKA_INTERNAL_URL=http://planka:1337

